# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Admin panel sign-in (/admin/)
ADMIN_PASSWORD=choose-a-long-password
ADMIN_SECRET=any-long-random-string

# Turso database (set automatically by the Turso integration on Vercel).
# Leave empty locally to use a SQLite file in .data/ instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob for uploaded images (set automatically when a Blob store is connected on Vercel).
# Leave empty locally to save uploads in public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=
